{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://codelens-ai-powered-codebase.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://codelens-ai-powered-codebase.onrender.com/auth/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}