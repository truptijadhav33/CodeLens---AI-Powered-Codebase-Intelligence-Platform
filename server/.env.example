MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
