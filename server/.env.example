MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:5000/auth/github/callback
GEMINI_API_KEY=your_gemini_api_key
JWT_SECRET=your_long_random_jwt_secret
# AES-256-GCM key used to encrypt GitHub access tokens at rest. Use a 64-char
# hex string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# or any long passphrase. Export BEFORE your first login; encrypted tokens require
# the same key to decrypt. Run node scripts/encryptExistingTokens.js to migrate.
ENCRYPTION_KEY=your_64_char_hex_or_long_passphrase
# Ingestion guardrails (limits for a single repository)
MAX_REPO_FILES=1500
MAX_REPO_SIZE_MB=50